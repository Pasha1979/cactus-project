{
  "name": "cactus-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "My Cactus — мозг проекта (brain v4). Код приложений: Android/ и Windows/ (Flutter).",
  "scripts": {
    "brain:links": "node scripts/brain/check-links.mjs",
    "brain:status": "node scripts/brain/gen-status.mjs",
    "brain:regs": "node scripts/brain/check-registries.mjs",
    "brain:refs": "node scripts/brain/check-refs.mjs",
    "brain:boot": "node scripts/brain/check-boot.mjs",
    "brain:next": "node scripts/brain/next.mjs",
    "brain:handoff": "node scripts/brain/gen-handoff.mjs",
    "brain:coverage": "node scripts/brain/check-coverage.mjs",
    "brain:guard": "node scripts/brain/check-context-guard.mjs",
    "brain:search": "node scripts/brain/search.mjs",
    "brain:auto-checkpoint": "node scripts/brain/auto-checkpoint.mjs",
    "brain:lesson": "node scripts/brain/lesson.mjs",
    "brain:impact": "node scripts/brain/impact.mjs",
    "brain:trend": "node scripts/brain/trend.mjs",
    "brain:digest": "node scripts/brain/digest.mjs",
    "brain:lint": "node scripts/brain/brain-lint.mjs",
    "brain:role": "node scripts/brain/role-info.mjs",
    "brain:check": "npm run brain:links && npm run brain:regs && npm run brain:refs && npm run brain:boot && npm run brain:handoff-check && npm run brain:coverage && npm run brain:guard",
    "gate": "cd Android && flutter analyze && cd ../Windows && flutter analyze && cd .. && npm run brain:check",
    "brain:handoff-check": "node scripts/brain/check-handoff.mjs",
    "brain:checkpoint": "node scripts/brain/gen-checkpoint.mjs",
    "brain:promote": "node scripts/brain/promote.mjs",
    "brain:ideas": "node scripts/brain/gen-ideas.mjs",
    "brain:add": "node scripts/brain/add.mjs",
    "brain:sync": "npm run brain:status && npm run brain:checkpoint && npm run brain:handoff && npm run brain:ideas && npm run brain:refs",
    "brain:test": "vitest run scripts/brain",
    "prepare": "node scripts/hooks/install.mjs"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
